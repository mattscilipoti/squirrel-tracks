# Squirrel Tracks Development Environment Template
# Copy to backend/.env, web-frontend/.env, etc. and fill in values

# ====== BACKEND (Rails) ======
# backend/.env

RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# SQLite (local development)
# Database files: storage/development.sqlite3, storage/test.sqlite3
# No additional configuration needed - Rails handles it automatically

# Rails
API_PORT=3000
API_BASE_URL=http://localhost:3000/api
CORS_ORIGINS=localhost:3000,localhost:5000,127.0.0.1:3000

# Logging
LOG_LEVEL=debug

# ====== WEB FRONTEND ======
# web-frontend/.env

# Point to your Rails API
API_BASE_URL=http://localhost:3000/api
# OR for remote testing:
# API_BASE_URL=http://your-deployed-api.com/api

# Optional: Google Analytics tracking ID
GOOGLE_ANALYTICS_ID=

# ====== iOS APP ======
# ios-app/.env (configure via Xcode build settings instead)

# API endpoint - use localhost or container network
API_BASE_URL=http://host.docker.internal:3000/api
# OR for iOS simulator on macOS:
# API_BASE_URL=http://localhost:3000/api

# Enable debug logging
DEBUG=true

# Optional: Sentry error tracking (free tier available)
SENTRY_DSN=

# ====== DEVCONTAINER ======
# .devcontainer/.env (if needed for build-time variables)

RAILS_ENV=development
BUNDLE_PATH=/workspaces/squirrel_tracks/bundle

# ====== DEPLOYMENT ======
# (Add when deploying to staging/production)

# Railway or Render
RAILWAY_APP_NAME=ett-api
RENDER_API_KEY=

# SQLite doesn't need cloud DB for small projects
# For larger scale, consider migrating to PostgreSQL on Railway/Render

# AWS (if using S3 for exports)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

