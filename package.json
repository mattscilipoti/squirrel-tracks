{
  "name": "squirrel-tracks",
  "private": true,
  "scripts": {
    "lint": "eslint web-frontend/js",
    "format": "prettier --write web-frontend",
    "format:check": "prettier --check web-frontend",
    "test": "node --test web-frontend/js/*.test.cjs scripts/*.test.cjs",
    "vendor": "esbuild web-frontend/vendor-src/entry.js --bundle --format=esm --minify --legal-comments=none --outfile=web-frontend/vendor/yjs.js",
    "start": "web-frontend/start-server.sh",
    "signaling": "y-webrtc-signaling",
    "check:signaling": "scripts/check-signaling.sh",
    "devices": "node scripts/devices.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.10.1",
    "qrcode-generator": "^1.4.4",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.20"
  }
}
